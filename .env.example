# MariaDB del servidor
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_username
MARIADB_PASSWORD=your_password
MARIADB_DATABASE=your_database

# Puerto del único proceso (web + API)
API_PORT=3001

# Opcional: ruta alternativa para los assets del juego
# ASSETS_PATH=/path/to/assets

# Opcional: nombres de tablas de datos de juego
# MOB_TABLE=mob_db_re
# MOB2_TABLE=mob_db2_re
# SPAWN_TABLE=mob_spawn
# ITEM_TABLE=item_db_re
