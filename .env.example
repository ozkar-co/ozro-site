# MariaDB del servidor (misma DB donde viven ozro_* + tablas live de rAthena)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_username
MARIADB_PASSWORD=your_password
MARIADB_DATABASE=your_database

# Puerto del único proceso (web + API)
API_PORT=3001

# Prefijo Master World Dataset (default ozro_)
# OZRO_TABLE_PREFIX=ozro_

# Opcional: ruta alternativa para assets visuales (mapas, atlases, sprites)
# ASSETS_PATH=/path/to/assets
